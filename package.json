{
  "name": "markdown-pr-diff",
  "version": "0.1.1",
  "private": true,
  "description": "Chrome extension: rendered side-by-side markdown diff for GitHub pull requests",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build:content": "vite build -c vite.content.config.ts",
    "build:main": "vite build -c vite.main.config.ts",
    "build": "npm run clean && npm run build:content && npm run build:main && node scripts/copy-static.mjs && node scripts/verify-dist.mjs",
    "dev": "vite -c vite.dev.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test dev scripts",
    "format": "prettier --write src test dev scripts",
    "package": "npm run build && node scripts/package.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "format:check": "prettier --check src test dev scripts"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "parse-diff": "^0.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/chrome": "^0.0.287",
    "@types/diff-match-patch": "^1.0.36",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.4",
    "eslint": "^9.37.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
